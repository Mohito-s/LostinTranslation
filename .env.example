# --- Обязательные переменные ---

# GEMINI_API_KEY: Required for Gemini AI API calls.
# Obtain one at https://aistudio.google.com/app/apikey
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# SESSION_SECRET: Used to sign developer session tokens (HMAC-SHA256).
# REQUIRED in production - the server will refuse to start without it.
# Generate one with: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="generate_a_random_secret"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Опциональные переменные ---

# DATABASE_URL / POSTGRES_URL: PostgreSQL / Supabase connection string.
# If left empty, the server uses the local JSON file (local_db.json) instead.
DATABASE_URL="postgresql://postgres:password@host:5432/postgres"

# GEMINI_MODEL: Gemini model used for analyze/enhance (default: gemini-3.5-flash)
# GEMINI_MODEL="gemini-3.5-flash"

# OPENAI_API_KEY: Optional. Enables real upstream forwarding for /v1/chat/completions drop-in proxy.
# If omitted, /v1/chat/completions provides optimized mock responses.
# OPENAI_API_KEY="sk-..."

# LOG_LEVEL: pino log level (trace|debug|info|warn|error). Default: info
# LOG_LEVEL="info"

# CORS_ORIGIN: allowed browser origins. "*" (default) or a comma-separated
# allowlist, e.g. "https://app.example.com,https://dev.example.com"
# CORS_ORIGIN="*"

# TRUST_PROXY: set to "true" or a hop count when running behind a reverse
# proxy / Cloud Run so that X-Forwarded-For is honored for rate limiting.
# TRUST_PROXY="true"

# PORT: HTTP port for the server (default: 3000)
# PORT="3000"

# SEED_DEMO_KEYS: when "true", the local DB bootstrap seeds the well-known demo
# keys (ltk_demokey12345 / ltk_freekey98765). Disable in production!
# SEED_DEMO_KEYS="true"
